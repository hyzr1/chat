# Hyzr Chat encrypts integration tokens and queued BYOK payloads. Generate 32 random bytes
# and encode them as base64. Local development creates ~/.hyzr/chat/master.key automatically.
HYZR_CHAT_ENCRYPTION_KEY=

# Required on Vercel. Pairing, account sessions, synchronized conversations,
# typed local RPC jobs, and device presence use this serverless Redis REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GitHub App: repository-scoped automation, not a personal access token.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# Linear OAuth application and organization webhook.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_REDIRECT_URI=http://localhost:3000/api/integrations/linear/oauth/callback
LINEAR_WEBHOOK_SECRET=

# Optional workflow-state synchronization after comments are posted.
LINEAR_STARTED_STATE_ID=
LINEAR_DONE_STATE_ID=

# Optional benchmark control. Live mode consumes subscription/API capacity.
HYZR_CHAT_BENCHMARK_LIVE=0
HYZR_CHAT_BENCHMARK_PREMIUM_MODEL=gpt-5.6-sol
# Hard stop for the complete paired evaluation. Usage can only be measured after
# a provider call returns, so one in-flight call may finish above this boundary.
HYZR_CHAT_BENCHMARK_TOKEN_CEILING=120000

# Required before exposing a local pilot over Wi-Fi/LAN. Localhost remains direct;
# remote devices pair once at /pair and receive an HttpOnly cookie.
HYZR_CHAT_ACCESS_TOKEN=

# Optional per-million-token accounting for local subscription models. Hyzr Chat does
# not invent prices; cost telemetry stays null until the operator supplies them.
HYZR_CHAT_BASELINE_MODEL_ID=gpt-5.6-sol
HYZR_CHAT_MODEL_PRICING_JSON={}

# Former VMX_* names remain accepted as migration fallbacks but should not be
# used in new installations.
